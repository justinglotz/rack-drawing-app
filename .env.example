# Copy to .env and adjust. Compose reads this file automatically.

# --- Postgres (dev container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rack_drawing
POSTGRES_PORT=5432

# --- Backend ---
# In Compose this is set automatically to point at the postgres service.
# For production, point at your managed database (Neon/Supabase/RDS/etc.).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flex rental API — required for importing pullsheets.
# Base REST URL (e.g. https://spectrum.flexrentalsolutions.com/f5/api) and your API token.
FLEX_BASE_API_URL=
FLEX_API_KEY=

# --- Frontend ---
# Browser-facing API base URL. Must include the /api prefix (backend mounts all
# routes under /api). Baked into the client bundle at build time for prod.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Server-side (SSR) API base URL used inside Docker, where "localhost" is the
# frontend container. Defaults to the backend service on the compose network.
INTERNAL_API_URL=http://backend:8000/api
